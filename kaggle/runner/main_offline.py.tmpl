"""Offline Kaggle runner (internet off, e.g. competition RTX Pro 6000 machines).

Code comes from the mounted code-snapshot kernel output (jobs/snapshot_code.sh), packages from the
mounted wheels kernel output (jobs/build_wheels.sh); models/datasets are mounted as usual.
Generated by tools/make_kernel.py --offline; do not edit the copy under kaggle/experiments/.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

JOB = "__JOB__"
JOB_ENV = __JOB_ENV__

INPUT = Path("/kaggle/input")
WORK = Path("/tmp/kltn")
SRC = WORK / "src"
OUT = Path("/kaggle/working/outputs")


def sh(cmd, log, env=None, cwd=None):
    log.write(f"\n$ {cmd}\n")
    log.flush()
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd, env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        log.write(line)
    log.flush()
    return proc.wait()


def find(marker):
    hits = sorted(INPUT.rglob(marker))
    if not hits:
        raise FileNotFoundError(f"{marker} not found under {INPUT}; is the kernel source attached?")
    return hits[0].parent


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    WORK.mkdir(parents=True, exist_ok=True)
    started = time.time()
    summary = {"job": JOB, "env": JOB_ENV, "offline": True}
    print("runner started", flush=True)
    with open(OUT / "run.log", "w") as log:
        sh("find /kaggle/input -maxdepth 4 | head -40", log)
        code_dir = find("kltn_code_snapshot.json")
        wheels_dir = find("wheels.txt")
        summary["snapshot"] = json.loads((code_dir / "kltn_code_snapshot.json").read_text())
        summary["commit"] = summary["snapshot"].get("commit")
        if SRC.exists():
            shutil.rmtree(SRC)
        shutil.copytree(code_dir, SRC)
        code = sh(f"pip install -q --no-index --find-links {wheels_dir} -r requirements-kaggle.txt", log, cwd=SRC)
        if code == 0:
            env = dict(os.environ, OUT_DIR=str(OUT), WORK_DIR=str(WORK), HF_HOME=str(WORK / "hf"),
                       HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1", PYTHONPATH=str(SRC), **JOB_ENV)
            code = sh(f"bash jobs/{JOB}.sh", log, env=env, cwd=SRC)
        summary["exit_code"] = code
        summary["minutes"] = round((time.time() - started) / 60, 1)
    (OUT / "result.json").write_text(json.dumps(summary, indent=2))
    print(json.dumps(summary))
    if code != 0:
        sys.exit(code)


main()
