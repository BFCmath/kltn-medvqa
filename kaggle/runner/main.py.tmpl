"""Kaggle runner: clone the project repo at a fixed ref and run one job script.

Generated by tools/make_kernel.py; do not edit the copy under kaggle/experiments/.
Everything written to $OUT_DIR (/kaggle/working/outputs) is downloaded by the
control plane when the kernel finishes, so jobs must keep large files elsewhere.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO = "__REPO__"
REF = "__REF__"
JOB = "__JOB__"
JOB_ENV = __JOB_ENV__

WORK = Path("/tmp/kltn")
SRC = WORK / "src"
OUT = Path("/kaggle/working/outputs")


def sh(cmd, log, env=None, cwd=None):
    log.write(f"\n$ {cmd}\n")
    log.flush()
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd, env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in proc.stdout:
        sys.stdout.write(line)
        log.write(line)
    log.flush()
    return proc.wait()


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    WORK.mkdir(parents=True, exist_ok=True)
    started = time.time()
    summary = {"job": JOB, "repo": REPO, "ref": REF, "env": JOB_ENV}
    with open(OUT / "run.log", "w") as log:
        if SRC.exists():
            shutil.rmtree(SRC)
        code = sh(f"git clone --depth 1 --branch {REF} --recurse-submodules --shallow-submodules {REPO} {SRC}", log)
        if code == 0:
            summary["commit"] = subprocess.run(["git", "-C", str(SRC), "rev-parse", "HEAD"],
                                               capture_output=True, text=True).stdout.strip()
            code = sh("pip install -q -r requirements-kaggle.txt", log, cwd=SRC)
        if code == 0:
            env = dict(os.environ, OUT_DIR=str(OUT), WORK_DIR=str(WORK),
                       HF_HOME=str(WORK / "hf"), PYTHONPATH=str(SRC), **JOB_ENV)
            code = sh(f"bash jobs/{JOB}.sh", log, env=env, cwd=SRC)
        summary["exit_code"] = code
        summary["minutes"] = round((time.time() - started) / 60, 1)
    (OUT / "result.json").write_text(json.dumps(summary, indent=2))
    print(json.dumps(summary))
    if code != 0:
        sys.exit(code)


main()
